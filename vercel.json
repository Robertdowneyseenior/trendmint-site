    },
    {
      "source": "/whatsapp-crm",
      "destination": "/#chatwaba",
      "permanent": false
    },
    {
      "source": "/digital-marketing-agency-lucknow",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lead-generation",
      "destination": "/#what",
      "permanent": false
    },
    {
      "source": "/video-ads-ugc",
      "destination": "/#what",
      "permanent": false
    },
    {
      "source": "/fixyourreels",
